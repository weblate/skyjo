{
  "name": "@skymo/discord-bot",
  "version": "1.0.0",
  "description": "Discord bot service for Skymo game platform",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && pnpx tsc-alias",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx dist/src/index.js",
    "biome:check": "biome check . --write"
  },
  "dependencies": {
    "@skymo/database": "workspace:*",
    "@skymo/logger": "workspace:*",
    "@skymo/ts-config": "workspace:*",
    "bullmq": "^5.56.1",
    "dayjs": "^1.11.13",
    "discord.js": "^14.21.0",
    "drizzle-orm": "^0.44.2",
    "redis": "^5.5.6",
    "zod": "^3.25.74"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
