{
  "extends": "@skymo/ts-config/base-node.json",
  "compilerOptions": {
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@env": ["./env.ts"]
    },
    "jsx": "preserve"
  },
  "include": ["src/**/*", "env.ts", "src/redis.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
