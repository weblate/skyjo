{
  "name": "@skymo/workers",
  "description": "Workers for Skymo",
  "version": "1.62.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "build": "tsc --build",
    "prod": "tsx dist/src/index.js",
    "biome:check": "pnpm biome check --write .",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui --coverage.enabled=true"
  },
  "dependencies": {
    "@skymo/database": "workspace:*",
    "@skymo/core": "workspace:*",
    "@skymo/error": "workspace:*",
    "@skymo/logger": "workspace:*",
    "@skymo/transactional": "workspace:*",
    "bullmq": "^5.56.1",
    "dotenv": "^17.0.1",
    "drizzle-orm": "^0.44.2",
    "react": "19.1.0",
    "redis": "^5.5.6",
    "resend": "^4.6.0",
    "zod": "^3.25.74"
  },
  "devDependencies": {
    "@skymo/ts-config": "workspace:*",
    "@skymo/worker-types": "workspace:*",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "@vitest/coverage-istanbul": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
