{
  "name": "@skymo/workers",
  "description": "Workers for Skymo",
  "version": "1.65.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "build": "tsc --build",
    "prod": "tsx dist/src/index.js",
    "biome:check": "pnpm biome check --write .",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui --coverage.enabled=true"
  },
  "dependencies": {
    "@skymo/database": "workspace:*",
    "@skymo/core": "workspace:*",
    "@skymo/error": "workspace:*",
    "@skymo/logger": "workspace:*",
    "@skymo/transactional": "workspace:*",
    "bullmq": "^5.63.2",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "react": "19.2.0",
    "redis": "^5.9.0",
    "resend": "^6.4.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@skymo/ts-config": "workspace:*",
    "@skymo/worker-types": "workspace:*",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "@vitest/coverage-istanbul": "^4.0.9",
    "@vitest/ui": "^4.0.9",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.9"
  }
