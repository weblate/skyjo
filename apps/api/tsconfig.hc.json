{
  "extends": "./tsconfig",
  "exclude": [
    "tests",
    "./src/**/__tests__",
    "vitest.config.ts",
    "**/*.mock.ts",
    "src/db/**/*",
    "src/realtime/**/*",
    "src/queues/**/*",
    "src/redis/**/*",
    "src/utils/**/*"
  ],
  "include": ["src/hc.ts"],
  "compilerOptions": {
    "outDir": "./dist/hc",
    "declaration": true,
    "declarationMap": true
  }
}
