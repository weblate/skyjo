{
  "name": "@skymo/api",
  "description": "Skymo API",
  "version": "1.49.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc --project tsconfig.prod.json && pnpx tsc-alias --project tsconfig.prod.json",
    "prod": "tsx dist/src/index.js",
    "biome:check": "pnpm biome check --write .",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui --coverage.enabled=true"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.1",
    "@skymo/core": "workspace:*",
    "@skymo/error": "workspace:*",
    "@skymo/logger": "workspace:*",
    "@skymo/shared": "workspace:*",
    "@skymo/state-operations": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^5.40.2",
    "dayjs": "^1.11.13",
    "hono": "^4.6.12",
    "rate-limiter-flexible": "^5.0.4",
    "redis": "^4.7.0",
    "socket.io": "^4.8.1",
    "socket.io-msgpack-parser": "^3.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^6.4.17",
    "@vitest/coverage-istanbul": "^2.1.6",
    "@vitest/ui": "^2.1.6",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite-tsconfig-paths": "^5.1.3",
    "vitest": "^2.1.6"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8",
    "utf-8-validate": "^6.0.5"
  }
}
