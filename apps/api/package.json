{
  "name": "@skymo/api",
  "description": "Skymo API",
  "version": "1.58.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc --project tsconfig.prod.json && pnpx tsc-alias --project tsconfig.prod.json",
    "prod": "tsx dist/src/index.js",
    "biome:check": "pnpm biome check --write .",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui --coverage.enabled=true"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@hono/zod-validator": "^0.4.3",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@skymo/core": "workspace:*",
    "@skymo/database": "workspace:*",
    "@skymo/error": "workspace:*",
    "@skymo/logger": "workspace:*",
    "@skymo/shared": "workspace:*",
    "@skymo/state-operations": "workspace:*",
    "@skymo/worker-types": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "arctic": "^3.6.1",
    "argon2": "^0.43.0",
    "bullmq": "^5.48.1",
    "dayjs": "^1.11.13",
    "drizzle-orm": "^0.43.1",
    "hono": "^4.7.6",
    "nodemailer": "^6.10.1",
    "rate-limiter-flexible": "^7.0.0",
    "redis": "^4.7.0",
    "sha2": "link:@oslojs/crypto/sha2",
    "socket.io": "^4.8.1",
    "socket.io-msgpack-parser": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/nodemailer": "^6.4.17",
    "@vitest/coverage-istanbul": "^3.1.1",
    "@vitest/ui": "^3.1.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.1.1"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.9",
    "utf-8-validate": "^6.0.5"
  }
}
