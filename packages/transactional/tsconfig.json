{
  "extends": "@skymo/ts-config/base-package.json",
  "compilerOptions": {
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/emails/*": ["./emails/*"],
      "@/constants": ["./src/constants.js"]
    },
    "jsx": "preserve"
  },
  "include": ["emails/**/*", "src/**/*"],
  "exclude": ["node_modules", "dist"]
}
