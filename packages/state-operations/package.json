{
  "name": "@skymo/state-operations",
  "description": "A package to handle game state operations",
  "version": "1.65.0",
  "type": "module",
  "exports": {
    ".": "./dist/src/index.js",
    "./*": "./dist/src/*.js"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*"
      ]
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.prod.json",
    "biome:check": "pnpm biome check --write .",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui --coverage.enabled=true"
  },
  "dependencies": {
    "@skymo/core": "workspace:*"
  },
  "devDependencies": {
    "@skymo/ts-config": "workspace:*",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "@vitest/coverage-istanbul": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
