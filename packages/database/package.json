{
  "name": "@skymo/database",
  "description": "PostgreSQL database schema and setup for Skymo",
  "version": "1.0.0",
  "type": "module",
  "types": "./dist/*.d.ts",
  "exports": {
    "./schema": "./src/schema.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "biome:check": "pnpm biome check --write .",
    "db:generate": "pnpm drizzle-kit generate",
    "db:migrate": "pnpm drizzle-kit migrate"
  },
  "dependencies": {
    "@skymo/core": "workspace:*",
    "@skymo/shared": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@skymo/ts-config": "workspace:*",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.7",
    "typescript": "^5.9.3"
  }
}
