{
  "name": "@skymo/shared",
  "description": "Shared types and validations between the server and the client",
  "version": "1.61.0",
  "type": "module",
  "types": "./dist/*.d.ts",
  "exports": {
    "./validations": "./dist/validations/index.js",
    "./utils": "./dist/utils/index.js",
    "./types": "./dist/types/index.d.ts",
    "./constants": "./dist/constants/index.js"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "biome:check": "pnpm biome check --write ."
  },
  "dependencies": {
    "@skymo/core": "workspace:*",
    "@skymo/error": "workspace:*",
    "@skymo/state-operations": "workspace:*",
    "zod": "^3.25.74"
  },
  "devDependencies": {
    "@skymo/ts-config": "workspace:*",
    "typescript": "^5.8.3"
  }
}
