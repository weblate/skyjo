{
  "name": "@skymo/core",
  "description": "Core logic of the game",
  "version": "1.58.0",
  "type": "module",
  "exports": {
    ".": "./dist/src/index.js",
    "./*": "./dist/src/*.js"
  },
  "typesVersions": {
    "*": {
      "*": ["./dist/*"]
    }
  },
  "scripts": {
    "build": "tsc",
    "biome:check": "pnpm biome check --write .",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui --coverage.enabled=true"
  },
  "dependencies": {
    "@skymo/error": "workspace:*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@skymo/ts-config": "workspace:*",
    "@types/node": "^22.14.1",
    "typescript": "^5.8.3",
    "@vitest/coverage-istanbul": "^3.1.1",
    "@vitest/ui": "^3.1.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.1.1"
  }
}
